// Pacote (pasta) onde a classe fica; precisa bater com a pasta real
package com.example.apirestwithspring.entities;

// Entidade: a classe que representa "o que é um Pokémon" no nosso sistema
public class Pokemon {

    private Long id;       // identificador único (Long aceita null, útil antes de salvar)
    private String nome;   // nome do pokémon, ex.: "Pikachu"
    private String tipo;   // tipo do pokémon, ex.: "Elétrico"
    private int nivel;     // nível do pokémon, ex.: 25

    // Construtor vazio: o Spring precisa dele para transformar o JSON recebido em objeto
    public Pokemon() {
    }

    // Construtor completo: facilita criar um Pokémon já com todos os dados
    public Pokemon(Long id, String nome, String tipo, int nivel) {
        this.id = id;        // guarda o id recebido no atributo da classe
        this.nome = nome;    // guarda o nome
        this.tipo = tipo;    // guarda o tipo
        this.nivel = nivel;  // guarda o nível
    }

    public Long getId() { return id; }                       // devolve o id
    public void setId(Long id) { this.id = id; }             // altera o id

    public String getNome() { return nome; }                 // devolve o nome
    public void setNome(String nome) { this.nome = nome; }   // altera o nome

    public String getTipo() { return tipo; }                 // devolve o tipo
    public void setTipo(String tipo) { this.tipo = tipo; }   // altera o tipo

    public int getNivel() { return nivel; }                  // devolve o nível
    public void setNivel(int nivel) { this.nivel = nivel; }  // altera o nível
}